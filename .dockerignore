# dependencies
node_modules
.pnp
.pnp.*

# next.js build/cache output
.next
out

# production
build

# testing
coverage

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (Dockerfile/compose supply these via environment/DATA_DIR instead)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

