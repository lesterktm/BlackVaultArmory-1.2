prisma/dev.db
prisma/dev.db-journal
prisma/prisma/*.db
prisma/prisma/*.db-journal
*.db

# local data / uploads (mounted as volumes at runtime, not baked into the image)
data
uploads

# git
.git
.gitignore

# misc project files not needed in the image
.blackvault.env
.worktrees
